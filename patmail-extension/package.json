{
  "name": "patmail-extension",
  "private": true,
  "version": "1.4.8",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:all": "vitest run && node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/stream-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e": "node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/stream-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:files": "node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:download": "node tests/e2e/download.e2e.mjs",
    "test:e2e:stream-download": "node tests/e2e/stream-download.e2e.mjs",
    "test:stream-bridge": "python -m unittest discover -s tests -p *bridge_test.py",
    "test:e2e:download-editor": "node tests/e2e/download-editor.e2e.mjs",
    "test:e2e:limits": "node tests/e2e/limit-query.e2e.mjs",
    "test:e2e:docs": "node tests/e2e/docs.e2e.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "pack:delivery": "node scripts/pack-delivery.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "live:readonly": "node scripts/live-readonly.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "mermaid": "^11",
    "sql.js": "^1.14.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
