{
  "name": "patmail-extension",
  "private": true,
  "version": "1.6.4",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/cdp-observer.mjs start && vue-tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "cdp:start": "node scripts/cdp-observer.mjs start",
    "cdp:status": "node scripts/cdp-observer.mjs status",
    "cdp:stop": "node scripts/cdp-observer.mjs stop",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/native-browser-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e": "node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/native-browser-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:files": "node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:download": "node tests/e2e/download.e2e.mjs",
    "test:e2e:stream-download": "node tests/e2e/stream-download.e2e.mjs",
    "test:stream-bridge": "python -m unittest discover -s tests -p *bridge_test.py",
    "test:e2e:download-editor": "node tests/e2e/download-editor.e2e.mjs",
    "test:e2e:prewarm-pagination": "node scripts/run-e2e.mjs prewarm-pagination",
    "test:e2e:jihua-upload": "node scripts/run-e2e.mjs jihua-upload",
    "test:e2e:durable-download": "node tests/e2e/durable-download.e2e.mjs",
    "test:e2e:browser-download": "node tests/e2e/native-browser-download.e2e.mjs",
    "test:e2e:pipeline-fault": "node tests/e2e/native-pipeline-fault.e2e.mjs",
    "test:e2e:browser-store": "node tests/e2e/browser-download-store.e2e.mjs",
    "test:e2e:limits": "node tests/e2e/limit-query.e2e.mjs",
    "test:e2e:docs": "node tests/e2e/docs.e2e.mjs",
    "test:e2e:smoke": "node scripts/run-e2e.mjs smoke",
    "test:e2e:full": "node scripts/run-e2e.mjs full",
    "test:e2e:legacy": "node scripts/run-e2e.mjs legacy",
    "lint": "node scripts/eslint-ratchet.mjs",
    "lint:eslint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"scripts/{eslint-ratchet,verify-manifest,verify-dist,verify-reproducible,run-e2e,scan-secrets,ci-report,ci-check,license-check,release-check}.mjs\" \"eslint.config.js\" \"vitest.config.ts\" \"ci/**/*.json\" \"docs/ci/**/*.md\" \"../.github/**/*.{yml,yaml}\"",
    "format:write": "prettier --write \"scripts/{eslint-ratchet,verify-manifest,verify-dist,verify-reproducible,run-e2e,scan-secrets,ci-report,ci-check,license-check,release-check}.mjs\" \"eslint.config.js\" \"vitest.config.ts\" \"ci/**/*.json\" \"docs/ci/**/*.md\" \"../.github/**/*.{yml,yaml}\"",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:repro": "node scripts/verify-reproducible.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:history": "node scripts/scan-secrets.mjs --history",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "licenses:check": "node scripts/license-check.mjs",
    "ci:report": "node scripts/ci-report.mjs",
    "ci:check": "node scripts/ci-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "pack:delivery": "node scripts/pack-delivery.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "live:readonly": "node scripts/live-readonly.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.0",
    "mermaid": "^11",
    "sql.js": "^1.14.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
