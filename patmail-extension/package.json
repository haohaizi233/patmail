{
  "name": "patmail-extension",
  "private": true,
  "version": "1.6.5",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build/ensure-sme-snapshot.mjs && node scripts/cdp/cdp-observer.mjs start && pnpm build:bundle",
    "build:ci": "node scripts/build/ensure-sme-snapshot.mjs && pnpm build:bundle",
    "build:bundle": "vue-tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "cdp:start": "node scripts/cdp/cdp-observer.mjs start",
    "cdp:status": "node scripts/cdp/cdp-observer.mjs status",
    "cdp:stop": "node scripts/cdp/cdp-observer.mjs stop",
    "typecheck": "vue-tsc --noEmit",
    "architecture:check": "node scripts/architecture/architecture-check.mjs && node scripts/architecture/scripts-layout-check.mjs && vitest run tests/architecture",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/native-browser-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e": "node tests/e2e/extension.e2e.mjs && node tests/e2e/limit-query.e2e.mjs && node tests/e2e/download.e2e.mjs && node tests/e2e/native-browser-download.e2e.mjs && node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:file-manage": "node tests/e2e/file-manage-customer.e2e.mjs",
    "test:e2e:files": "node tests/e2e/file-pages.e2e.mjs",
    "test:e2e:download": "node tests/e2e/download.e2e.mjs",
    "test:e2e:stream-download": "node tests/e2e/stream-download.e2e.mjs",
    "test:stream-bridge": "python -m unittest discover -s tests -p *bridge_test.py",
    "test:e2e:download-editor": "node tests/e2e/download-editor.e2e.mjs",
    "test:e2e:prewarm-pagination": "node scripts/ci/run-e2e.mjs prewarm-pagination",
    "test:e2e:jihua-upload": "node scripts/ci/run-e2e.mjs jihua-upload",
    "test:e2e:billing": "node scripts/ci/run-e2e.mjs billing",
    "test:e2e:durable-download": "node tests/e2e/durable-download.e2e.mjs",
    "test:e2e:browser-download": "node tests/e2e/native-browser-download.e2e.mjs",
    "test:e2e:pipeline-fault": "node tests/e2e/native-pipeline-fault.e2e.mjs",
    "test:e2e:browser-store": "node tests/e2e/browser-download-store.e2e.mjs",
    "test:e2e:limits": "node tests/e2e/limit-query.e2e.mjs",
    "test:e2e:docs": "node tests/e2e/docs.e2e.mjs",
    "test:e2e:smoke": "node scripts/ci/run-e2e.mjs smoke",
    "test:e2e:full": "node scripts/ci/run-e2e.mjs full",
    "test:e2e:legacy": "node scripts/ci/run-e2e.mjs legacy",
    "lint": "node scripts/quality/eslint-ratchet.mjs",
    "lint:eslint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"scripts/{build/ensure-sme-snapshot,quality/eslint-ratchet,architecture/architecture-check,architecture/scripts-layout-check,shared/paths,build/verify-manifest,build/verify-dist,build/verify-reproducible,ci/run-e2e,security/scan-secrets,ci/ci-report,ci/ci-check,security/license-check,release/release-check}.mjs\" \"eslint.config.js\" \"vitest.config.ts\" \"ci/**/*.json\" \"docs/ci/**/*.md\" \"../.github/**/*.{yml,yaml}\"",
    "format:write": "prettier --write \"scripts/{build/ensure-sme-snapshot,quality/eslint-ratchet,architecture/architecture-check,architecture/scripts-layout-check,shared/paths,build/verify-manifest,build/verify-dist,build/verify-reproducible,ci/run-e2e,security/scan-secrets,ci/ci-report,ci/ci-check,security/license-check,release/release-check}.mjs\" \"eslint.config.js\" \"vitest.config.ts\" \"ci/**/*.json\" \"docs/ci/**/*.md\" \"../.github/**/*.{yml,yaml}\"",
    "verify:manifest": "node scripts/build/verify-manifest.mjs",
    "verify:dist": "node scripts/build/verify-dist.mjs",
    "verify:repro": "node scripts/build/verify-reproducible.mjs",
    "scan:secrets": "node scripts/security/scan-secrets.mjs",
    "scan:secrets:history": "node scripts/security/scan-secrets.mjs --history",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "licenses:check": "node scripts/security/license-check.mjs",
    "ci:report": "node scripts/ci/ci-report.mjs",
    "ci:check": "node scripts/ci/ci-check.mjs",
    "release:check": "node scripts/release/release-check.mjs",
    "pack:source": "node scripts/release/pack-source.mjs",
    "pack:delivery": "node scripts/release/pack-delivery.mjs",
    "verify:archive": "node scripts/release/verify-archive.mjs",
    "live:readonly": "node scripts/live-readonly.mjs",
    "docs:check": "node scripts/docs/docs-check.mjs",
    "docs:audit": "node scripts/docs/docs-audit.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@zip.js/zip.js": "2.25.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "mermaid": "^12",
    "saxes": "6.0.0",
    "sql.js": "^1.16.0",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.14"
  }
}
