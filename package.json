{
  "name": "patmail-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node patmail-extension/scripts/cdp-observer.mjs start && vite build",
    "cdp:start": "node patmail-extension/scripts/cdp-observer.mjs start",
    "cdp:status": "node patmail-extension/scripts/cdp-observer.mjs status",
    "cdp:stop": "node patmail-extension/scripts/cdp-observer.mjs stop",
    "architecture:check": "pnpm --dir patmail-extension architecture:check",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^6.0.0"
  }
}
